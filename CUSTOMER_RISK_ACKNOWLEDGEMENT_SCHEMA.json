{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GPT_EA Customer Risk Acknowledgement Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "terms_version",
    "acknowledgement_id",
    "accepted_at_utc",
    "jurisdiction",
    "license_reference_masked",
    "acknowledgements",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "GPT_EA_RISK_ACK_V1"
    },
    "terms_version": {
      "const": "GPT_EA_TERMS_20260917_V1"
    },
    "acknowledgement_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "accepted_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64
    },
    "license_reference_masked": {
      "type": "string",
      "minLength": 4,
      "maxLength": 64
    },
    "broker_company": {
      "type": "string",
      "maxLength": 128
    },
    "trade_server": {
      "type": "string",
      "maxLength": 128
    },
    "acknowledgements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commercial_terms",
        "trading_risk",
        "no_profit_guarantee",
        "possible_total_loss",
        "ai_limitations",
        "broker_third_party_risk",
        "personal_responsibility",
        "demo_first"
      ],
      "properties": {
        "commercial_terms": {
          "const": true
        },
        "trading_risk": {
          "const": true
        },
        "no_profit_guarantee": {
          "const": true
        },
        "possible_total_loss": {
          "const": true
        },
        "ai_limitations": {
          "const": true
        },
        "broker_third_party_risk": {
          "const": true
        },
        "personal_responsibility": {
          "const": true
        },
        "demo_first": {
          "const": true
        }
      }
    },
    "decision": {
      "const": "ACCEPTED"
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
