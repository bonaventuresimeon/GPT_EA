{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/bonaventuresimeon/GPT_EA/ROLLBACK_PACKAGE_MANIFEST_SCHEMA.json",
  "title":"GPT_EA Certified Rollback Package Manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","release_validation_id","source_git_sha","created_utc","migration_note","files"],
  "properties":{
    "schema_version":{"const":"rollback_package_manifest_v1"},
    "release_validation_id":{"type":"string","minLength":8},
    "source_git_sha":{"type":"string","pattern":"^[0-9a-fA-F]{40}$"},
    "created_utc":{"type":"string","minLength":10},
    "migration_note":{"type":"string","minLength":1},
    "files":{
      "type":"array","minItems":3,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["archive_path","source_path","sha256","size"],
        "properties":{
          "archive_path":{"type":"string","minLength":1},
          "source_path":{"type":"string","minLength":1},
          "sha256":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"},
          "size":{"type":"integer","minimum":1}
        }
      }
    }
  }
}
