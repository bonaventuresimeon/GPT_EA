        },
        "config_drift_fail_closed": {
          "const": true
        },
        "clock_drift_passed": {
          "const": true
        },
        "chaos_real_account_refusal_passed": {
          "const": true
        },
        "chaos_fault_matrix_passed": {
          "const": true
        },
        "macro_scenario_stress_passed": {
          "const": true
        },
        "gap_risk_passed": {
          "const": true
        },
        "margin_stress_passed": {
          "const": true
