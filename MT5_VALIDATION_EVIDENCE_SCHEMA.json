        "model_health_path",
        "model_health_sha256",
        "resilience_runtime_report_path",
        "resilience_runtime_report_sha256"
      ],
      "properties": {
        "experts_log_path": {
          "type": "string",
          "minLength": 1
        },
        "experts_log_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "journal_log_path": {
          "type": "string",
          "minLength": 1
        },
        "journal_log_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "broker_history_path": {
          "type": "string",
          "minLength": 1
        },
        "broker_history_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "matrix_bundle_path": {
          "type": "string",
          "minLength": 1
        },
        "matrix_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "intent_ledger_path": {
          "type": "string",
          "minLength": 1
        },
        "intent_ledger_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "reconciliation_path": {
          "type": "string",
          "minLength": 1
        },
        "reconciliation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "web_provenance_path": {
          "type": "string",
          "minLength": 1
        },
        "web_provenance_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "model_health_path": {
          "type": "string",
          "minLength": 1
        },
        "model_health_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "resilience_runtime_report_path": {
          "type": "string",
          "minLength": 1
        },
        "resilience_runtime_report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "operator_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reviewer",
        "timestamp",
        "notes"
      ],
      "properties": {
        "decision": {
          "const": "ACCEPT"
        },
        "reviewer": {
          "type": "string",
          "minLength": 2
        },
        "timestamp": {
          "type": "string",
          "minLength": 8
        },
        "notes": {
