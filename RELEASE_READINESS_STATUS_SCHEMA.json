{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/bonaventuresimeon/GPT_EA/RELEASE_READINESS_STATUS_SCHEMA.json",
  "title":"GPT_EA Release Readiness Status",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","release_validation_id","candidate_git_sha","generated_utc","code_readiness","evidence_readiness","overall_state"],
  "properties":{
    "schema_version":{"const":"release_readiness_status_v1"},
    "release_validation_id":{"const":"GPT_EA_FULL_INTELLIGENCE_R6_20260917"},
    "candidate_git_sha":{"type":"string","pattern":"^[0-9a-fA-F]{40}$"},
    "generated_utc":{"type":"string","minLength":10},
    "code_readiness":{
      "type":"object","additionalProperties":false,
      "required":["state","basis","static_result","source_git_sha","reason"],
      "properties":{
        "state":{"enum":["CODE_STATIC_HOLD","CODE_STATIC_READY"]},
        "basis":{"enum":["NONE","LOCAL_STATIC","CI_BUNDLE"]},
        "static_result":{"enum":["UNKNOWN","FAILED","PASS"]},
        "source_git_sha":{"type":"string"},
        "reason":{"type":"string","minLength":1}
      }
    },
    "evidence_readiness":{
      "type":"object","additionalProperties":false,
      "required":["state","missing_gates","final_review_decision","authoritative_validation_passed","reason"],
      "properties":{
        "state":{"enum":["EVIDENCE_HOLD","EVIDENCE_READY_FOR_FINAL_REVIEW","PRODUCTION_GO"]},
        "missing_gates":{"type":"array","items":{"type":"string"}},
        "final_review_decision":{"enum":["HOLD","GO","UNKNOWN"]},
        "authoritative_validation_passed":{"type":"boolean"},
        "reason":{"type":"string","minLength":1}
      }
    },
    "overall_state":{"enum":["HOLD","GO"]}
  }
}
