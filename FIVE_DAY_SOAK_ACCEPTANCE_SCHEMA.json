{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonaventuresimeon/GPT_EA/FIVE_DAY_SOAK_ACCEPTANCE_SCHEMA.json",
  "title": "GPT_EA R6 Five-Day Soak Acceptance Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","release_validation_id","record_id","evidence_id","record_digest","candidate","days","reconciliation","lifecycle_checks","operator_record_path","report_path","operator_review"],
  "properties": {
    "schema_version": {"const": "five_day_soak_acceptance_v2"},
    "release_validation_id": {"const": "GPT_EA_FULL_INTELLIGENCE_R6_20260917"},
    "record_id": {"type":"string","minLength":8},
    "evidence_id": {"type":"string","minLength":8},
    "record_digest": {"type":"string","pattern":"^[0-9a-fA-F]{64}$"},
    "candidate": {
      "type":"object","additionalProperties":false,
      "required":["git_sha","ex5_sha256","set_sha256","broker_company","trade_server","account_mode","account_currency","margin_mode","mt5_build","metaeditor_build"],
      "properties":{
        "git_sha":{"type":"string","pattern":"^[0-9a-fA-F]{40}$"},"ex5_sha256":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"},
        "set_sha256":{"type":"string","pattern":"^(NONE|[0-9a-fA-F]{64})$"},"broker_company":{"type":"string","minLength":1},
        "trade_server":{"type":"string","minLength":1},"account_mode":{"enum":["DEMO","CONTEST"]},"account_currency":{"type":"string","minLength":1},
        "margin_mode":{"type":"string","minLength":1},"mt5_build":{"type":"string","minLength":1},"metaeditor_build":{"type":"string","minLength":1}
      }
    },
    "days":{
      "type":"array","minItems":5,"maxItems":5,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["date","gap_justification","fresh_quotes","london_observed","ny_observed","overlap_observed","high_impact_news_observed","rollover_spread_expansion_observed","scheduled_scans","continuous_scans","manual_scans","checkpoint_updates","backup_checkpoint_updates","restarts","reconnects","high_confidence_decisions","wait_reanalyze_decisions","no_trade_decisions","zero_tolerance_failures","unresolved_critical_states_end","execution_log_present","stop_log_present","release_log_present","reconciliation_checklist_path","day_reconciled","reconciled_by","reconciled_at"],
        "properties":{
          "date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"gap_justification":{"type":"string"},
          "fresh_quotes":{"const":true},"london_observed":{"type":"boolean"},"ny_observed":{"type":"boolean"},"overlap_observed":{"type":"boolean"},
          "high_impact_news_observed":{"type":"boolean"},"rollover_spread_expansion_observed":{"type":"boolean"},
          "scheduled_scans":{"type":"integer","minimum":0},"continuous_scans":{"type":"integer","minimum":0},"manual_scans":{"type":"integer","minimum":0},
          "checkpoint_updates":{"type":"integer","minimum":0},"backup_checkpoint_updates":{"type":"integer","minimum":0},"restarts":{"type":"integer","minimum":0},"reconnects":{"type":"integer","minimum":0},
          "high_confidence_decisions":{"type":"integer","minimum":0},"wait_reanalyze_decisions":{"type":"integer","minimum":0},"no_trade_decisions":{"type":"integer","minimum":0},
          "zero_tolerance_failures":{"const":0},"unresolved_critical_states_end":{"const":0},
          "execution_log_present":{"const":true},"stop_log_present":{"const":true},"release_log_present":{"const":true},
          "reconciliation_checklist_path":{"type":"string","minLength":1},"day_reconciled":{"const":true},
          "reconciled_by":{"type":"string","minLength":2},"reconciled_at":{"type":"string","minLength":8}
        }
      }
    },
    "reconciliation":{
      "type":"object","additionalProperties":false,
      "required":["duplicate_orders","duplicate_partials","sl_regressions","unprotected_new_authorizations","release_gate_bypasses","analytics_duplicate_finalizations","stop_failure_join_failures","dashboard_gate_mismatches","runtime_critical_errors","secrets_exposed"],
      "properties":{"duplicate_orders":{"const":0},"duplicate_partials":{"const":0},"sl_regressions":{"const":0},"unprotected_new_authorizations":{"const":0},"release_gate_bypasses":{"const":0},"analytics_duplicate_finalizations":{"const":0},"stop_failure_join_failures":{"const":0},"dashboard_gate_mismatches":{"const":0},"runtime_critical_errors":{"const":0},"secrets_exposed":{"const":0}}
    },
    "lifecycle_checks":{
      "type":"object","additionalProperties":false,
      "required":["stale_human_wait_closed","market_confirmation_wait_preserved","denial_timeout_terminal","restart_reconstruction_passed","no_illegal_transition_accepted"],
      "properties":{"stale_human_wait_closed":{"const":true},"market_confirmation_wait_preserved":{"const":true},"denial_timeout_terminal":{"const":true},"restart_reconstruction_passed":{"const":true},"no_illegal_transition_accepted":{"const":true}}
    },
    "operator_record_path":{"type":"string","minLength":1},
    "report_path":{"type":"string","minLength":1},
    "operator_review":{"type":"object","additionalProperties":false,"required":["decision","reviewer","timestamp","notes"],"properties":{"decision":{"const":"ACCEPT"},"reviewer":{"type":"string","minLength":2},"timestamp":{"type":"string","minLength":8},"notes":{"type":"string"}}}
  }
}
