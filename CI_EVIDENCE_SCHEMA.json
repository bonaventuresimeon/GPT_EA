{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonaventuresimeon/GPT_EA/CI_EVIDENCE_SCHEMA.json",
  "title": "GPT_EA GitHub Actions Static Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_utc",
    "repository",
    "workflow",
    "job",
    "event",
    "ref",
    "run_id",
    "run_attempt",
    "run_url",
    "job_id",
    "job_url",
    "runner_id",
    "runner_name",
    "runner_group_id",
    "runner_group_name",
    "steps_executed",
    "static_job_conclusion",
    "head_sha",
    "tree_sha",
    "runner_os",
    "runner_arch",
    "static_outcome",
    "result",
    "static_check_sha256",
    "ci_log_sha256",
    "job_metadata_sha256",
    "source_manifest_sha256",
    "errors",
    "evidence_digest"
  ],
  "properties": {
    "schema_version": {"const": "github_actions_static_evidence_v1"},
    "generated_utc": {"type": "string", "minLength": 10},
    "repository": {"const": "bonaventuresimeon/GPT_EA"},
    "workflow": {"type": "string", "minLength": 1},
    "job": {"const": "static-release-gate"},
    "event": {"type": "string", "minLength": 1},
    "ref": {"type": "string", "minLength": 1},
    "run_id": {"type": "integer", "minimum": 1},
    "run_attempt": {"type": "integer", "minimum": 1},
    "run_url": {"type": "string", "minLength": 20},
    "job_id": {"type": "integer", "minimum": 1},
    "job_url": {"type": "string", "minLength": 20},
    "runner_id": {"type": "integer", "minimum": 1},
    "runner_name": {"type": "string", "minLength": 1},
    "runner_group_id": {"type": "integer", "minimum": 0},
    "runner_group_name": {"type": "string"},
    "steps_executed": {"type": "integer", "minimum": 7},
    "static_job_conclusion": {"const": "success"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "tree_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "runner_os": {"type": "string", "minLength": 1},
    "runner_arch": {"type": "string", "minLength": 1},
    "static_outcome": {"const": "success"},
    "result": {"const": "PASS"},
    "static_check_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "ci_log_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "job_metadata_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "errors": {"type": "array", "maxItems": 0},
    "evidence_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
  }
}
