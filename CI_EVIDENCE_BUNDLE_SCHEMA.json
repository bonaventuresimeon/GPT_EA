{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonaventuresimeon/GPT_EA/CI_EVIDENCE_BUNDLE_SCHEMA.json",
  "title": "GPT_EA CI Evidence Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_validation_id",
    "candidate_sha",
    "artifact_name",
    "run_id",
    "run_attempt",
    "job_id",
    "runner_id",
    "steps_executed",
    "attestation_verified",
    "files",
    "bundle_digest"
  ],
  "properties": {
    "schema_version": {"const": "ci_evidence_bundle_v1"},
    "release_validation_id": {"const": "GPT_EA_FULL_INTELLIGENCE_R6_20260917"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "artifact_name": {"type": "string", "minLength": 8},
    "run_id": {"type": "integer", "minimum": 1},
    "run_attempt": {"type": "integer", "minimum": 1},
    "job_id": {"type": "integer", "minimum": 1},
    "runner_id": {"type": "integer", "minimum": 1},
    "steps_executed": {"type": "integer", "minimum": 7},
    "attestation_verified": {"const": true},
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "static-check.txt",
        "static-check-ci.txt",
        "ci-job-metadata.json",
        "ci-evidence.json",
        "ci-evidence-validation.txt",
        "ci-evidence-manifest.txt",
        "ci-attestation-verify.txt"
      ],
      "properties": {
        "static-check.txt": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "static-check-ci.txt": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "ci-job-metadata.json": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "ci-evidence.json": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "ci-evidence-validation.txt": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "ci-evidence-manifest.txt": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "ci-attestation-verify.txt": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "bundle_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
  }
}
