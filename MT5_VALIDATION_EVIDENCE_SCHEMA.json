        "web_search_path_passed",
        "failure_injection_passed",
        "recovery_after_failure_passed",
        "request_trace_observed",
        "required_failure_fail_closed",
        "secret_leak_count"
      ],
      "properties": {
        "webrequest_allow_list_verified": {
          "const": true
        },
        "deep_review_path_passed": {
          "const": true
        },
        "web_search_path_passed": {
          "const": true
        },
        "failure_injection_passed": {
          "const": true
        },
        "recovery_after_failure_passed": {
          "const": true
        },
        "request_trace_observed": {
          "const": true
        },
        "required_failure_fail_closed": {
          "const": true
        },
        "secret_leak_count": {
          "const": 0
