    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experts_log_path",
        "experts_log_sha256",
        "journal_log_path",
        "journal_log_sha256",
        "broker_history_path",
        "broker_history_sha256",
        "matrix_bundle_path",
        "matrix_bundle_sha256",
        "intent_ledger_path",
        "intent_ledger_sha256",
        "reconciliation_path",
        "reconciliation_sha256",
        "web_provenance_path",
