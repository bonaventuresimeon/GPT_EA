      "required": [
        "broker_matrix_passed",
        "symbol_profiles_archived",
        "stops_freeze_geometry_verified",
        "tick_value_size_verified",
        "volume_geometry_verified",
        "filling_order_modes_verified",
        "margin_lot_normalization_verified",
        "restart_reconstruction_passed",
        "reconnect_reconstruction_passed",
        "primary_checkpoint_passed",
        "backup_checkpoint_passed",
        "no_duplicate_after_recovery"
      ],
      "properties": {
        "broker_matrix_passed": {
          "const": true
        },
        "symbol_profiles_archived": {
          "const": true
        },
        "stops_freeze_geometry_verified": {
          "const": true
        },
        "tick_value_size_verified": {
          "const": true
        },
        "volume_geometry_verified": {
          "const": true
        },
        "filling_order_modes_verified": {
          "const": true
        },
        "margin_lot_normalization_verified": {
          "const": true
        },
        "restart_reconstruction_passed": {
          "const": true
        },
        "reconnect_reconstruction_passed": {
          "const": true
        },
        "primary_checkpoint_passed": {
          "const": true
        },
        "backup_checkpoint_passed": {
          "const": true
        },
        "no_duplicate_after_recovery": {
          "const": true
        }
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stop_matrix_passed",
        "broker_stop_policy_passed",
        "partial_protection_passed",
        "stop_observability_passed",
