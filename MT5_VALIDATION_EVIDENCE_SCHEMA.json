{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonaventuresimeon/GPT_EA/MT5_VALIDATION_EVIDENCE_SCHEMA.json",
  "title": "GPT_EA R6 MT5 Validation Evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_validation_id",
    "evidence_id",
    "evidence_digest",
    "candidate",
    "environment",
    "compile",
    "strategy_tester",
    "broker_runtime",
    "protection",
    "live_api_news",
    "resilience_runtime",
    "artifacts",
    "operator_review"
  ],
  "properties": {
    "schema_version": {
      "const": "mt5_validation_evidence_v2"
    },
    "release_validation_id": {
      "const": "GPT_EA_FULL_INTELLIGENCE_R6_20260917"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 8
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_sha",
        "ex5_sha256",
        "set_sha256"
      ],
      "properties": {
        "git_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "ex5_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "set_sha256": {
          "type": "string",
          "pattern": "^(NONE|[0-9a-fA-F]{64})$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metaeditor_build",
        "mt5_build",
        "broker_company",
        "trade_server",
        "account_mode",
        "account_currency",
        "margin_mode"
      ],
      "properties": {
        "metaeditor_build": {
          "type": "string",
          "minLength": 1
        },
        "mt5_build": {
          "type": "string",
          "minLength": 1
        },
        "broker_company": {
          "type": "string",
          "minLength": 1
        },
        "trade_server": {
          "type": "string",
          "minLength": 1
        },
        "account_mode": {
          "enum": [
            "DEMO",
            "CONTEST"
          ]
        },
        "account_currency": {
          "type": "string",
          "minLength": 1
        },
        "margin_mode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "compile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "errors",
        "warnings",
        "compile_log_path",
        "compile_log_sha256",
        "load_smoke_passed",
        "init_error_count",
        "symbols_resolved_or_safely_rejected",
        "timer_started",
        "dashboard_initialized",
        "release_blocked_before_attestation",
        "no_order_on_attach"
      ],
      "properties": {
        "passed": {
          "const": true
        },
        "errors": {
          "const": 0
        },
        "warnings": {
          "const": 0
        },
        "compile_log_path": {
          "type": "string",
          "minLength": 1
        },
        "compile_log_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "load_smoke_passed": {
          "const": true
        },
        "init_error_count": {
          "const": 0
        },
        "symbols_resolved_or_safely_rejected": {
          "const": true
        },
        "timer_started": {
          "const": true
        },
        "dashboard_initialized": {
          "const": true
        },
        "release_blocked_before_attestation": {
          "const": true
        },
        "no_order_on_attach": {
          "const": true
        }
      }
    },
    "strategy_tester": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "report_path",
        "report_sha256",
        "model",
        "date_from",
        "date_to",
        "symbols",
        "completed_runs",
        "no_runtime_critical_errors",
        "no_duplicate_orders",
        "no_duplicate_partials",
        "no_sl_regressions",
        "no_unprotected_authorizations"
      ],
      "properties": {
        "passed": {
          "const": true
        },
        "report_path": {
          "type": "string",
          "minLength": 1
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "date_from": {
          "type": "string",
          "minLength": 8
        },
        "date_to": {
          "type": "string",
          "minLength": 8
        },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completed_runs": {
          "type": "integer",
          "minimum": 1
        },
        "no_runtime_critical_errors": {
          "const": true
        },
        "no_duplicate_orders": {
          "const": true
        },
        "no_duplicate_partials": {
          "const": true
        },
        "no_sl_regressions": {
          "const": true
        },
        "no_unprotected_authorizations": {
          "const": true
        }
      }
    },
    "broker_runtime": {
      "type": "object",
