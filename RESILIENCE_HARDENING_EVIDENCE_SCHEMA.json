{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/bonaventuresimeon/GPT_EA/RESILIENCE_HARDENING_EVIDENCE_SCHEMA.json",
  "title":"GPT_EA R6 Resilience Hardening Evidence",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","release_validation_id","evidence_id","evidence_digest","candidate_git_sha","config_fingerprint","matrix_path","matrix_sha256","checks","operator_review"],
  "properties":{
    "schema_version":{"const":"resilience_hardening_evidence_v1"},
    "release_validation_id":{"const":"GPT_EA_FULL_INTELLIGENCE_R6_20260917"},
    "evidence_id":{"type":"string","minLength":8},
    "evidence_digest":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"},
    "candidate_git_sha":{"type":"string","pattern":"^[0-9a-fA-F]{40}$"},
    "config_fingerprint":{"type":"string","pattern":"^[0-9A-Fa-f]{8}$"},
    "matrix_path":{"type":"string","minLength":1},
    "matrix_sha256":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"},
    "checks":{
      "type":"object","additionalProperties":false,
      "required":["direct_breakout","broker_reconciliation","atomic_intent_exactly_once","news_provenance_timestamp","clock_model_degradation","data_versioning_quarantine","promotion_significance_rollback","strategy_registry","portfolio_gap_margin_latency","chaos_fault_injection","storage_config_manual_integrity","causal_attribution","rollback_package"],
      "properties":{
        "direct_breakout":{"const":true},
        "broker_reconciliation":{"const":true},
        "atomic_intent_exactly_once":{"const":true},
        "news_provenance_timestamp":{"const":true},
        "clock_model_degradation":{"const":true},
        "data_versioning_quarantine":{"const":true},
        "promotion_significance_rollback":{"const":true},
        "strategy_registry":{"const":true},
        "portfolio_gap_margin_latency":{"const":true},
        "chaos_fault_injection":{"const":true},
        "storage_config_manual_integrity":{"const":true},
        "causal_attribution":{"const":true},
        "rollback_package":{"const":true}
      }
    },
    "operator_review":{
      "type":"object","additionalProperties":false,
      "required":["decision","reviewer","timestamp","notes"],
      "properties":{"decision":{"const":"ACCEPT"},"reviewer":{"type":"string","minLength":2},"timestamp":{"type":"string","minLength":8},"notes":{"type":"string"}}
    }
  }
}
